@model IEnumerable<CourseInfoListVM>
@{
    ViewData["Title"] = "Kurslar";
}

<div class="admin-card">
    <div class="admin-card-header">
        <h5><i class="bi bi-book me-2 text-success"></i>Kurslar</h5>
        <a asp-action="Create" class="btn btn-sm btn-success">
            <i class="bi bi-plus-lg me-1"></i>Yeni Kurs
        </a>
    </div>
    <div class="table-responsive">
        <table class="table admin-table mb-0">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Şəkil</th>
                    <th>Başlıq</th>
                    <th>Qiymət</th>
                    <th>Satış</th>
                    <th>Müəllim</th>
                    <th>Statuslar</th>
                    <th class="text-end">Əməliyyat</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="8" class="text-center text-muted py-4">Heç bir kurs tapılmadı.</td></tr>
                }
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="text-muted small">@item.Id</td>
                        <td>
                            @if (!string.IsNullOrEmpty(item.Image))
                            {
                                <img src="@FileHelper.GetImageUrl(item.Image)" alt="@item.Title"
                                     style="width:56px;height:40px;object-fit:cover;border-radius:6px;" />
                            }
                        </td>
                        <td>
                            <span class="fw-semibold text-truncate d-inline-block" style="max-width:160px">
                                @item.Title
                            </span>
                        </td>
                        <td><span class="badge bg-success">@item.Price ₼</span></td>
                        <td class="text-muted small">@item.SalesCount</td>
                        <td class="text-muted small">@item.TeacherName</td>
                        <td>
                            @if (item.IsFeatured)
                            {
                                <span class="badge bg-warning text-dark me-1">Seçilmiş</span>
                            }
                            @if (item.IsNew)
                            {
                                <span class="badge bg-primary">Yeni</span>
                            }
                        </td>
                        <td class="text-end">
                            <a asp-action="Details" asp-route-id="@item.Id"
                               class="btn btn-sm btn-outline-info me-1">
                                <i class="bi bi-eye"></i>
                            </a>
                            <a asp-action="Edit" asp-route-id="@item.Id"
                               class="btn btn-sm btn-outline-warning me-1">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <form asp-action="Delete" asp-route-id="@item.Id"
                                  method="post" class="d-inline"
                                  onsubmit="return confirm('Bu kursu silmək istədiyinizə əminsiniz?')">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
