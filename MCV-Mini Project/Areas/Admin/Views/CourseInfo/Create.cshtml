@model CourseInfoCreateVM
@{
    ViewData["Title"] = "Yeni Kurs";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="admin-card">
            <div class="admin-card-header">
                <h5><i class="bi bi-plus-circle me-2 text-success"></i>Yeni Kurs</h5>
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
                    <i class="bi bi-arrow-left me-1"></i>Geri
                </a>
            </div>
            <div class="p-4">
                <form asp-action="Create" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label asp-for="Title" class="form-label fw-semibold">Başlıq</label>
                        <input asp-for="Title" class="form-control" placeholder="Kurs adı" />
                        <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label fw-semibold">Açıqlama</label>
                        <textarea asp-for="Description" class="form-control" rows="3"
                                  placeholder="Kurs haqqında qısa məlumat"></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="Price" class="form-label fw-semibold">Qiymət (₼)</label>
                            <input asp-for="Price" type="number" class="form-control" min="0" />
                            <span asp-validation-for="Price" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="SalesCount" class="form-label fw-semibold">Satış Sayı</label>
                            <input asp-for="SalesCount" type="number" class="form-control" min="0" />
                            <span asp-validation-for="SalesCount" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="TeacherId" class="form-label fw-semibold">Müəllim</label>
                        <select asp-for="TeacherId" asp-items="ViewBag.Teachers" class="form-select">
                            <option value="">— Müəllim seçin —</option>
                        </select>
                        <span asp-validation-for="TeacherId" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Şəkil <span class="text-danger">*</span></label>
                        <div class="drop-zone">
                            <input type="file" asp-for="ImageFile" accept="image/*" />
                            <i class="bi bi-cloud-arrow-up"></i>
                            <div class="dz-label">Fayl seçin və ya <span>yükləyin</span></div>
                        </div>
                        <img class="img-preview mt-2" alt="preview" />
                        <span asp-validation-for="ImageFile" class="text-danger small"></span>
                    </div>

                    <div class="mb-4 d-flex gap-4">
                        <div class="form-check form-switch">
                            <input asp-for="IsFeatured" class="form-check-input" type="checkbox" />
                            <label asp-for="IsFeatured" class="form-check-label fw-semibold">Seçilmiş</label>
                        </div>
                        <div class="form-check form-switch">
                            <input asp-for="IsNew" class="form-check-input" type="checkbox" />
                            <label asp-for="IsNew" class="form-check-label fw-semibold">Yeni</label>
                        </div>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-success">
                            <i class="bi bi-check-lg me-1"></i>Əlavə et
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Ləğv et</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
