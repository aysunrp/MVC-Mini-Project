@model AuthorCreateVM
@{
    ViewData["Title"] = "Yeni Müəllif";
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="admin-card">
            <div class="admin-card-header">
                <h5><i class="bi bi-plus-circle me-2 text-danger"></i>Yeni Müəllif</h5>
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
                    <i class="bi bi-arrow-left me-1"></i>Geri
                </a>
            </div>
            <div class="p-4">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()

                    <div class="mb-4">
                        <label asp-for="FullName" class="form-label fw-semibold">Ad Soyad</label>
                        <input asp-for="FullName" class="form-control" placeholder="Müəllif adı" />
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-danger">
                            <i class="bi bi-check-lg me-1"></i>Əlavə et
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Ləğv et</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
