@model IEnumerable<AuthorListVM>
@{
    ViewData["Title"] = "Authors";
}

<div class="admin-card">
    <div class="admin-card-header">
        <h5><i class="bi bi-person-lines-fill me-2 text-danger"></i>Authors</h5>
        <a asp-action="Create" class="btn btn-sm btn-danger">
            <i class="bi bi-plus-lg me-1"></i>Add Author
        </a>
    </div>
    <div class="table-responsive">
        <table class="table admin-table mb-0">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Full Name</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="3" class="text-center text-muted py-4">Heç bir müəllif tapılmadı.</td></tr>
                }
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="text-muted small">@item.Id</td>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <div class="rounded-circle bg-danger text-white d-flex align-items-center
                                            justify-content-center fw-bold"
                                     style="width:34px;height:34px;font-size:.8rem">
                                    @item.FullName.Substring(0, 1).ToUpper()
                                </div>
                                <span class="fw-semibold">@item.FullName</span>
                            </div>
                        </td>
                        <td class="text-end">
                            <a asp-action="Details" asp-route-id="@item.Id"
                               class="btn btn-sm btn-outline-info me-1">
                                Detail
                            </a>
                            <a asp-action="Edit" asp-route-id="@item.Id"
                               class="btn btn-sm btn-outline-warning me-1">
                                Edit
                            </a>
                            <form asp-action="Delete" asp-route-id="@item.Id"
                                  method="post" class="d-inline"
                                  onsubmit="return confirm('Bu müəllifi silmək istədiyinizə əminsiniz?')">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                    Delete
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
