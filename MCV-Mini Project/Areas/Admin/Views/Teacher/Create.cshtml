@model TeacherCreateVM
@{
    ViewData["Title"] = "Yeni Müəllim";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="admin-card">
            <div class="admin-card-header">
                <h5><i class="bi bi-plus-circle me-2 text-info"></i>Yeni Müəllim</h5>
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
                    <i class="bi bi-arrow-left me-1"></i>Geri
                </a>
            </div>
            <div class="p-4">
                <form asp-action="Create" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label asp-for="FullName" class="form-label fw-semibold">Ad Soyad</label>
                        <input asp-for="FullName" class="form-control" placeholder="Müəllim adı" />
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Şəkil <span class="text-danger">*</span></label>
                        <div class="drop-zone">
                            <input type="file" asp-for="ImageFile" accept="image/*" />
                            <i class="bi bi-cloud-arrow-up"></i>
                            <div class="dz-label">Fayl seçin və ya <span>yükləyin</span></div>
                        </div>
                        <img class="img-preview mt-2" alt="preview" />
                        <span asp-validation-for="ImageFile" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="PositionId" class="form-label fw-semibold">Vəzifə</label>
                        <select asp-for="PositionId" asp-items="ViewBag.Positions" class="form-select">
                            <option value="">— Vəzifə seçin —</option>
                        </select>
                        <span asp-validation-for="PositionId" class="text-danger small"></span>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-info text-white">
                            <i class="bi bi-check-lg me-1"></i>Əlavə et
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Ləğv et</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
