@model IEnumerable<TeacherListVM>
@{
    ViewData["Title"] = "Müəllimlər";
}

<div class="admin-card">
    <div class="admin-card-header">
        <h5><i class="bi bi-person-workspace me-2 text-info"></i>Müəllimlər</h5>
        <a asp-action="Create" class="btn btn-sm btn-info text-white">
            <i class="bi bi-plus-lg me-1"></i>Yeni Müəllim
        </a>
    </div>
    <div class="table-responsive">
        <table class="table admin-table mb-0">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Şəkil</th>
                    <th>Ad Soyad</th>
                    <th>Vəzifə</th>
                    <th class="text-end">Əməliyyat</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="5" class="text-center text-muted py-4">Heç bir müəllim tapılmadı.</td></tr>
                }
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="text-muted small">@item.Id</td>
                        <td>
                            <img src="@FileHelper.GetImageUrl(item.Image)" alt="@item.FullName"
                                 class="rounded-circle object-fit-cover"
                                 style="width:38px;height:38px;"
                                 onerror="this.src='/images/no-image.png'" />
                        </td>
                        <td class="fw-semibold">@item.FullName</td>
                        <td>
                            <span class="badge bg-info-subtle text-info border border-info-subtle">
                                @item.PositionName
                            </span>
                        </td>
                        <td class="text-end">
                            <a asp-action="Details" asp-route-id="@item.Id"
                               class="btn btn-sm btn-outline-info me-1">
                                <i class="bi bi-eye"></i>
                            </a>
                            <a asp-action="Edit" asp-route-id="@item.Id"
                               class="btn btn-sm btn-outline-warning me-1">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <form asp-action="Delete" asp-route-id="@item.Id"
                                  method="post" class="d-inline"
                                  onsubmit="return confirm('Bu müəllimi silmək istədiyinizə əminsiniz?')">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
