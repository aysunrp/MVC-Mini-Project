@model SliderCreateVM
@{ ViewData["Title"] = "Add Slider"; }

<div class="row justify-content-center">
<div class="col-lg-7">
<div class="ac">
    <div class="ac-head">
        <h5><i class="bi bi-plus-circle me-2" style="color:#ff8a00"></i>Add Slider</h5>
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Back</a>
    </div>
    <div class="p-4">
        <form asp-action="Create" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label asp-for="Logo" class="form-label fw-semibold">Logo (şəkil adı)</label>
                <input asp-for="Logo" class="form-control" placeholder="məs: home_slider_logo.png" />
                <span asp-validation-for="Logo" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold">Image <span class="text-danger">*</span></label>
                <div class="drop-zone" onclick="document.getElementById('sliderImg').click()">
                    <input type="file" id="sliderImg" asp-for="ImageFile" accept="image/*" />
                    <i class="bi bi-cloud-arrow-up"></i>
                    <div class="dz-label">Drag & drop or <span>browse</span> to upload</div>
                    <div class="text-muted" style="font-size:.75rem">PNG, JPG, WEBP — max 5 MB</div>
                </div>
                <img class="img-preview mt-2" alt="preview" />
                <span asp-validation-for="ImageFile" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Title" class="form-label fw-semibold">Title</label>
                <input asp-for="Title" class="form-control" placeholder="Slider title" />
                <span asp-validation-for="Title" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Description" class="form-label fw-semibold">Description</label>
                <textarea asp-for="Description" class="form-control" rows="3" placeholder="Short description"></textarea>
                <span asp-validation-for="Description" class="text-danger small"></span>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-orange"><i class="bi bi-check-lg me-1"></i>Save</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
</div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
