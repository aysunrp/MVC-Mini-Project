@model IEnumerable<SliderListVM>
@{ ViewData["Title"] = "Sliders"; }

<div class="ac">
    <div class="ac-head">
        <h5><i class="bi bi-images me-2" style="color:#ff8a00"></i>Sliders</h5>
        <a asp-action="Create" class="btn btn-sm btn-orange">
            <i class="bi bi-plus-lg me-1"></i>Add Slider
        </a>
    </div>
    <div class="table-responsive">
        <table class="table at mb-0">
            <thead><tr>
                <th>#</th><th>Image</th><th>Logo</th><th>Title</th><th>Description</th>
                <th class="text-end">Actions</th>
            </tr></thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="6" class="text-center text-muted py-4">No sliders found.</td></tr>
                }
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="text-muted small align-middle">@item.Id</td>
                        <td class="align-middle">
                            @if (!string.IsNullOrEmpty(item.Image))
                            {
                                <img src="@FileHelper.GetImageUrl(item.Image)" alt="slide"
                                     style="width:56px;height:40px;object-fit:cover;border-radius:6px;" />
                            }
                            else { <span class="text-muted small">—</span> }
                        </td>
                        <td class="align-middle"><code class="small">@item.Logo</code></td>
                        <td class="fw-semibold align-middle">@item.Title</td>
                        <td class="text-muted small align-middle">
                            <span class="text-truncate d-inline-block" style="max-width:150px">@item.Description</span>
                        </td>
                        <td class="text-end align-middle">
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary me-1" title="Details"><i class="bi bi-eye"></i></a>
                            <a asp-action="Edit"    asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning me-1"   title="Edit"><i class="bi bi-pencil"></i></a>
                            <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline"
                                  onsubmit="return confirm('Delete this slider?')">
                                @Html.AntiForgeryToken()
                                <button class="btn btn-sm btn-outline-danger" title="Delete"><i class="bi bi-trash"></i></button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
