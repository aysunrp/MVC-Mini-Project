@model SliderEditVM
@{ ViewData["Title"] = "Slider Details"; }

<div class="row justify-content-center"><div class="col-lg-7">
<div class="ac">
    <div class="ac-head">
        <h5><i class="bi bi-eye me-2 text-info"></i>Slider Details — #@Model.Id</h5>
        <div class="d-flex gap-2">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-sm btn-warning"><i class="bi bi-pencil me-1"></i>Edit</a>
            <a asp-action="Index" class="btn btn-sm btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Back</a>
        </div>
    </div>
    <div class="p-4">
        @if (!string.IsNullOrEmpty(Model.CurrentImage))
        {
            <img src="@FileHelper.GetImageUrl(Model.CurrentImage)" alt="slider"
                 style="width:100%;max-height:220px;object-fit:cover;border-radius:8px;margin-bottom:1.25rem;" />
        }
        <dl class="row mb-0">
            <dt class="col-sm-3 text-muted">Logo Class</dt>
            <dd class="col-sm-9"><code>@Model.Logo</code></dd>
            <dt class="col-sm-3 text-muted">Title</dt>
            <dd class="col-sm-9 fw-semibold">@Model.Title</dd>
            <dt class="col-sm-3 text-muted">Description</dt>
            <dd class="col-sm-9">@Model.Description</dd>
        </dl>
    </div>
</div>
</div></div>
