@model SliderEditVM
@{ ViewData["Title"] = "Edit Slider"; }

<div class="row justify-content-center">
<div class="col-lg-7">
<div class="ac">
    <div class="ac-head">
        <h5><i class="bi bi-pencil me-2 text-warning"></i>Edit Slider — #@Model.Id</h5>
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Back</a>
    </div>
    <div class="p-4">
        <form asp-action="Edit" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <input asp-for="Id" type="hidden" />

            <div class="mb-3">
                <label asp-for="Logo" class="form-label fw-semibold">Logo (şəkil adı)</label>
                <input asp-for="Logo" class="form-control" />
                <span asp-validation-for="Logo" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold">Image</label>
                @if (!string.IsNullOrEmpty(Model.CurrentImage))
                {
                    <div class="mb-2">
                        <img src="@FileHelper.GetImageUrl(Model.CurrentImage)" alt="current"
                             style="width:100%;max-height:180px;object-fit:cover;border-radius:8px;border:1px solid #e5e7eb" />
                        <div class="text-muted small mt-1">Current image — upload a new one to replace</div>
                    </div>
                }
                <div class="drop-zone">
                    <input type="file" asp-for="ImageFile" accept="image/*" />
                    <i class="bi bi-cloud-arrow-up"></i>
                    <div class="dz-label">Drag & drop or <span>browse</span> to replace</div>
                </div>
                <img class="img-preview mt-2" alt="preview" />
            </div>

            <div class="mb-3">
                <label asp-for="Title" class="form-label fw-semibold">Title</label>
                <input asp-for="Title" class="form-control" />
                <span asp-validation-for="Title" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Description" class="form-label fw-semibold">Description</label>
                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Description" class="text-danger small"></span>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-warning"><i class="bi bi-check-lg me-1"></i>Update</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
</div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
