@model NewsCreateVM
@{
    ViewData["Title"] = "Yeni Xəbər";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="admin-card">
            <div class="admin-card-header">
                <h5><i class="bi bi-plus-circle me-2 text-success"></i>Yeni Xəbər</h5>
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
                    <i class="bi bi-arrow-left me-1"></i>Geri
                </a>
            </div>
            <div class="p-4">
                <form asp-action="Create" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Şəkil <span class="text-danger">*</span></label>
                        <div class="drop-zone">
                            <input type="file" asp-for="ImageFile" accept="image/*" />
                            <i class="bi bi-cloud-arrow-up"></i>
                            <div class="dz-label">Fayl seçin və ya <span>yükləyin</span></div>
                        </div>
                        <img class="img-preview mt-2" alt="preview" />
                        <span asp-validation-for="ImageFile" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Question" class="form-label fw-semibold">Sual / Başlıq</label>
                        <textarea asp-for="Question" class="form-control" rows="2"
                                  placeholder="Xəbər başlığı"></textarea>
                        <span asp-validation-for="Question" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Date" class="form-label fw-semibold">Tarix</label>
                        <input asp-for="Date" class="form-control" placeholder="01 Yanvar 2026" />
                        <span asp-validation-for="Date" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="AuthorId" class="form-label fw-semibold">Müəllif</label>
                        <select asp-for="AuthorId" asp-items="ViewBag.Authors" class="form-select">
                            <option value="">— Müəllif seçin —</option>
                        </select>
                        <span asp-validation-for="AuthorId" class="text-danger small"></span>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-success">
                            <i class="bi bi-check-lg me-1"></i>Əlavə et
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Ləğv et</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
