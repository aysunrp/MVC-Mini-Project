@model SettingEditVM
@{
    ViewData["Title"] = "Parametr Redaktə";
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="admin-card">
            <div class="admin-card-header">
                <h5><i class="bi bi-pencil me-2 text-warning"></i>Parametr Redaktə — #@Model.Id</h5>
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
                    <i class="bi bi-arrow-left me-1"></i>Geri
                </a>
            </div>
            <div class="p-4">
                <form asp-action="Edit" method="post">
                    @Html.AntiForgeryToken()
                    <input asp-for="Id" type="hidden" />

                    <div class="mb-3">
                        <label asp-for="Key" class="form-label fw-semibold">Açar (Key)</label>
                        <input asp-for="Key" class="form-control" />
                        <span asp-validation-for="Key" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Value" class="form-label fw-semibold">Dəyər (Value)</label>
                        <textarea asp-for="Value" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="Value" class="text-danger small"></span>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-warning">
                            <i class="bi bi-check-lg me-1"></i>Yenilə
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Ləğv et</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
