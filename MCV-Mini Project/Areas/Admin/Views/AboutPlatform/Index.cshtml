@model IEnumerable<AboutPlatformListVM>
@{
    ViewData["Title"] = "About Platform";
}

<div class="admin-card">
    <div class="admin-card-header">
        <h5><i class="bi bi-building me-2"></i>About Platform</h5>
        <a asp-action="Create" class="btn btn-sm btn-dark">
            <i class="bi bi-plus-lg me-1"></i>Add Record
        </a>
    </div>
    <div class="table-responsive">
        <table class="table admin-table mb-0">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Title</th>
                    <th>Description</th>
                    <th>Image</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="5" class="text-center text-muted py-4">Heç bir qeyd tapılmadı.</td></tr>
                }
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="text-muted small">@item.Id</td>
                        <td class="fw-semibold">@item.Title</td>
                        <td>
                            <span class="text-muted small text-truncate d-inline-block" style="max-width:180px">
                                @item.Description
                            </span>
                        </td>
                        <td>
                            @if (!string.IsNullOrEmpty(item.Image))
                            {
                                <img src="@FileHelper.GetImageUrl(item.Image)" alt="platform"
                                     style="width:56px;height:40px;object-fit:cover;border-radius:6px;" />
                            }
                        </td>
                        <td class="text-end">
                            <a asp-action="Details" asp-route-id="@item.Id"
                               class="btn btn-sm btn-outline-info me-1">
                                Detail
                            </a>
                            <a asp-action="Edit" asp-route-id="@item.Id"
                               class="btn btn-sm btn-outline-warning me-1">
                                Edit
                            </a>
                            <form asp-action="Delete" asp-route-id="@item.Id"
                                  method="post" class="d-inline"
                                  onsubmit="return confirm('Bu qeydi silmək istədiyinizə əminsiniz?')">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                    Delete
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
