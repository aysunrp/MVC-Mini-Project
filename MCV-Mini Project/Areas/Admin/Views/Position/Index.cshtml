@model IEnumerable<PositionListVM>
@{
    ViewData["Title"] = "Positions";
}

<div class="admin-card">
    <div class="admin-card-header">
        <h5><i class="bi bi-briefcase me-2 text-secondary"></i>Positions</h5>
        <a asp-action="Create" class="btn btn-sm btn-secondary">
            <i class="bi bi-plus-lg me-1"></i>Add Position
        </a>
    </div>
    <div class="table-responsive">
        <table class="table admin-table mb-0">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Name</th>
                    <th>Teacher Count</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="4" class="text-center text-muted py-4">Heç bir vəzifə tapılmadı.</td></tr>
                }
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="text-muted small">@item.Id</td>
                        <td class="fw-semibold">@item.Name</td>
                        <td>
                            <span class="badge bg-secondary">@item.TeacherCount müəllim</span>
                        </td>
                        <td class="text-end">
                            <a asp-action="Details" asp-route-id="@item.Id"
                               class="btn btn-sm btn-outline-info me-1">
                                Detail
                            </a>
                            <a asp-action="Edit" asp-route-id="@item.Id"
                               class="btn btn-sm btn-outline-warning me-1">
                                Edit
                            </a>
                            <form asp-action="Delete" asp-route-id="@item.Id"
                                  method="post" class="d-inline"
                                  onsubmit="return confirm('Bu vəzifəni silmək istədiyinizə əminsiniz?')">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                    Delete
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
