@model EventEditVM
@{
    ViewData["Title"] = "Tədbir Redaktə";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="admin-card">
            <div class="admin-card-header">
                <h5><i class="bi bi-pencil me-2 text-warning"></i>Tədbir Redaktə — #@Model.Id</h5>
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
                    <i class="bi bi-arrow-left me-1"></i>Geri
                </a>
            </div>
            <div class="p-4">
                <form asp-action="Edit" method="post">
                    @Html.AntiForgeryToken()
                    <input asp-for="Id" type="hidden" />

                    <div class="row mb-3">
                        <div class="col-md-3">
                            <label asp-for="DateDay" class="form-label fw-semibold">Gün</label>
                            <input asp-for="DateDay" class="form-control" />
                            <span asp-validation-for="DateDay" class="text-danger small"></span>
                        </div>
                        <div class="col-md-9">
                            <label asp-for="DateMonth" class="form-label fw-semibold">Ay</label>
                            <input asp-for="DateMonth" class="form-control" />
                            <span asp-validation-for="DateMonth" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Title" class="form-label fw-semibold">Başlıq</label>
                        <input asp-for="Title" class="form-control" />
                        <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Location" class="form-label fw-semibold">Yer</label>
                        <input asp-for="Location" class="form-control" />
                        <span asp-validation-for="Location" class="text-danger small"></span>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-warning">
                            <i class="bi bi-check-lg me-1"></i>Yenilə
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Ləğv et</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
