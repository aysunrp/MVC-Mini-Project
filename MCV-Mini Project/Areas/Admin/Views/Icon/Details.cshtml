@model IconEditVM
@{ ViewData["Title"] = "Icon Details"; }

<div class="row justify-content-center"><div class="col-lg-6">
<div class="ac">
    <div class="ac-head">
        <h5><i class="bi bi-eye me-2 text-info"></i>Icon Details — #@Model.Id</h5>
        <div class="d-flex gap-2">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-sm btn-warning"><i class="bi bi-pencil me-1"></i>Edit</a>
            <a asp-action="Index" class="btn btn-sm btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Back</a>
        </div>
    </div>
    <div class="p-4">
        <dl class="row mb-0">
            <dt class="col-sm-4 text-muted">CSS Class</dt>
            <dd class="col-sm-8"><code>@Model.Name</code></dd>
            <dt class="col-sm-4 text-muted">Preview</dt>
            <dd class="col-sm-8"><i class="@Model.Name fs-2"></i></dd>
        </dl>
    </div>
</div>
</div></div>
