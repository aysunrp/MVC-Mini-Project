@using MCV_Mini_Project.ViewModels.CourseInfos
@model CourseInfoUIVM?
@{
    var featured = Model;
    var featuredImage = FileHelper.GetImageUrl(featured?.CourseImages?.FirstOrDefault(x => x.IsMain)?.Name
                        ?? featured?.CourseImages?.FirstOrDefault()?.Name);
}

@if (featured != null)
{
<div class="featured">
    <div class="container">
        <div class="row">
            <div class="col">
                <div class="home_slider_nav_container d-flex flex-row align-items-start justify-content-between">
                    <div class="home_slider_nav home_slider_prev trans_200"><i class="fa fa-angle-left" aria-hidden="true"></i></div>
                    <div class="home_slider_nav home_slider_next trans_200"><i class="fa fa-angle-right" aria-hidden="true"></i></div>
                </div>
                <div class="featured_container">
                    <div class="row">
                        <div class="col-lg-6 featured_col">
                            <div class="featured_content">
                                <div class="featured_header d-flex flex-row align-items-center justify-content-start">
                                    <div class="featured_tag"><a asp-controller="Courses" asp-action="Detail" asp-route-id="@featured.Id">Featured</a></div>
                                    <div class="featured_price ml-auto">Price: <span>$@featured.Price</span></div>
                                </div>
                                <div class="featured_title">
                                    <h3>
                                        <a asp-controller="Courses" asp-action="Detail" asp-route-id="@featured.Id">@featured.Title</a>
                                    </h3>
                                </div>
                                <div class="featured_text">
                                    <a asp-controller="Courses" asp-action="Detail" asp-route-id="@featured.Id" class="course-desc-link">
                                        @featured.Description
                                    </a>
                                </div>
                                <div class="featured_footer d-flex align-items-center justify-content-start">
                                    <div class="featured_author_image">
                                        <img src="@FileHelper.GetImageUrl(featured.Teacher?.Image)" alt="">
                                    </div>
                                    <div class="featured_author_name">By @featured.Teacher?.FullName</div>
                                    <div class="featured_sales ml-auto"><span>@featured.SalesCount</span> Sales</div>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-6 featured_col">
                            <a asp-controller="Courses" asp-action="Detail" asp-route-id="@featured.Id" class="course-image-link">
                                <div class="featured_background" style="background-image:url('@featuredImage')"></div>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
}
