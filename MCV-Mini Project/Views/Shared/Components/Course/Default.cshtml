@model IEnumerable<CourseInfoUIVM>
<div class="courses">
    <div class="container">
        <div class="row">
            <div class="col-lg-10 offset-lg-1">
                <div class="section_title text-center"><h2>Choose your course</h2></div>
                <div class="section_subtitle">Suspendisse tincidunt magna eget massa hendrerit efficitur. Ut euismod pellentesque imperdiet. Cras laoreet gravida lectus, at viverra lorem venenatis in. Aenean id varius quam. Nullam bibendum interdum dui, ac tempor lorem convallis ut</div>
            </div>
        </div>
        <div class="row">
            <div class="col">
                <div class="course_search">
                    <form asp-controller="Courses" asp-action="Search" method="get" class="course_search_form d-flex flex-md-row flex-column align-items-start justify-content-between">
                        <div><input type="text" name="name" class="course_input" placeholder="Course"></div>
                        <div><input type="text" class="course_input" placeholder="Level"></div>
                        <button type="submit" class="course_button"><span>search course</span><span class="button_arrow"><i class="fa fa-angle-right" aria-hidden="true"></i></span></button>
                    </form>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col">
                <div class="courses_slider_container">
                    <div class="owl-carousel owl-theme courses_slider">
                        @foreach (var item in Model)
                        {
                            var cardImage = FileHelper.GetImageUrl(item.CourseImages?.FirstOrDefault(x => x.IsMain)?.Name
                                            ?? item.CourseImages?.FirstOrDefault()?.Name);
                            <div class="owl-item">
                                <div class="course">
                                    <div class="course_image">
                                        <a asp-controller="Courses" asp-action="Detail" asp-route-id="@item.Id" class="course-image-link">
                                            <img src="@cardImage" alt="@item.Title">
                                        </a>
                                    </div>
                                    <div class="course_body">
                                        <div class="course_header d-flex flex-row align-items-center justify-content-start">
                                            @if (item.IsFeatured)
                                            {
                                                <div class="course_tag"><a asp-controller="Courses" asp-action="Detail" asp-route-id="@item.Id">Featured</a></div>
                                            }
                                            else if (item.IsNew)
                                            {
                                                <div class="course_tag"><a asp-controller="Courses" asp-action="Detail" asp-route-id="@item.Id">New</a></div>
                                            }
                                            <div class="course_price ml-auto">Price: <span>$@item.Price</span></div>
                                        </div>
                                        <div class="course_title">
                                            <h3>
                                                <a asp-controller="Courses" asp-action="Detail" asp-route-id="@item.Id">@item.Title</a>
                                            </h3>
                                        </div>
                                        <div class="course_text">
                                            <a asp-controller="Courses" asp-action="Detail" asp-route-id="@item.Id" class="course-desc-link">
                                                @item.Description
                                            </a>
                                        </div>
                                        <div class="course_footer d-flex align-items-center justify-content-start">
                                            <div class="course_author_image">
                                                <img src="@FileHelper.GetImageUrl(item.Teacher?.Image)" alt="">
                                            </div>
                                            <div class="course_author_name">By @item.Teacher?.FullName</div>
                                            <div class="course_sales ml-auto"><span>@item.SalesCount</span> Sales</div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                    <div class="courses_slider_nav courses_slider_prev trans_200"><i class="fa fa-angle-left" aria-hidden="true"></i></div>
                    <div class="courses_slider_nav courses_slider_next trans_200"><i class="fa fa-angle-right" aria-hidden="true"></i></div>
                </div>
            </div>
        </div>
    </div>
</div>
