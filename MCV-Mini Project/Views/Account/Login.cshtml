@model LoginVM
@{
    ViewData["Title"] = "Login";
}

<div class="auth-page">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-5 col-md-7">
                <div class="auth-card">
                    <h2>Login</h2>
                    <p class="auth-lead">Sign in with your email and password.</p>

                    <form asp-action="Login" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="ReturnUrl" />
                        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                        <div class="form-group mb-3">
                            <label asp-for="Email"></label>
                            <input asp-for="Email" class="form-control" autocomplete="username" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="Password"></label>
                            <div class="password-field">
                                <input asp-for="Password" class="form-control" autocomplete="current-password" />
                                <button type="button" class="password-toggle" aria-label="Show password">
                                    <i class="fa fa-eye-slash" aria-hidden="true"></i>
                                </button>
                            </div>
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>

                        <div class="form-check mb-4">
                            <input asp-for="RememberMe" class="form-check-input" />
                            <label asp-for="RememberMe" class="form-check-label"></label>
                        </div>

                        <button type="submit" class="auth-btn">Login</button>
                    </form>

                    @if (ViewBag.ShowResend == true)
                    {
                        <p class="auth-switch mt-3">
                            <a asp-action="ResendConfirmation" asp-route-email="@ViewBag.ResendEmail">Resend confirmation email</a>
                        </p>
                    }

                    <p class="auth-switch">
                        Need to confirm your email?
                        <a asp-action="ResendConfirmation">Email confirmation</a>
                    </p>
                    <p class="auth-switch">Need an account? <a asp-action="Register">Register</a></p>
                </div>
            </div>
        </div>
    </div>
</div>
